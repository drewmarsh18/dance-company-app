{
  "expo": {
    "name": "College Dance Prep",
    "slug": "cdp",
    "scheme": "cdp",
    "version": "1.3.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.collegedanceprep.app",
      "buildNumber": "7",
      "infoPlist": {
        "NSCameraUsageDescription": "Used for scanning barcodes.",
        "NSPhotoLibraryUsageDescription": "Used for selecting profile photos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.collegedanceprep.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#e91e8c",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "de5c78bc-0077-4ec5-a31c-f4d746710f84"
      }
    }
  }
}